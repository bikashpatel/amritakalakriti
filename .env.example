# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Long random string — generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# First admin account (created on first start; run `npm run seed -- --reset-admin` to reset its password)
ADMIN_EMAIL=admin@amritakalakriti.com
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin

# Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys).
# Leave empty to run checkout in DEMO mode (no money is charged).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for <BASE_URL>/webhooks/razorpay (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Minutes an unpaid online order holds its artworks before they are released
PENDING_ORDER_TTL_MINUTES=30
