# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Public address of the site — used in links, the sitemap and social previews
BASE_URL=http://localhost:3000

# Long random string (required in production, min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# First admin account (created on first start; run `npm run seed -- --reset-admin` to reset its password)
ADMIN_EMAIL=admin@amritakalakriti.com
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin

# Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys) — optional.
# UPI payments are set up in Admin → Settings instead. Without these keys Razorpay is hidden in production,
# and in development it runs in DEMO mode (a simulated gateway; no money is charged).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for <BASE_URL>/webhooks/razorpay (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Minutes an unpaid online order holds its artworks before they are released
PENDING_ORDER_TTL_MINUTES=30

# ---- Deployment ----
# Folder for the database and uploaded photos. The Docker image sets this to /app/data (mount a volume there).
# DATA_DIR=
# Number of proxies in front of the app (Cloudflare Tunnel, Nginx or a load balancer = 1). "false" if none.
TRUST_PROXY=1
# Set to 1 only when ALL traffic reaches the app through Cloudflare (e.g. Cloudflare Tunnel),
# so rate limits use the visitor's real IP from the CF-Connecting-IP header.
BEHIND_CLOUDFLARE=0
# Token for the optional Cloudflare Tunnel container (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
