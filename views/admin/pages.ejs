<%- include('partials/top') %>

<div class="page-head">
  <div class="page-head-text">
    <p class="page-head-lead">The store’s information pages — your story, shipping, returns and policies. Changes go live as soon as you save.</p>
  </div>
</div>

<section class="card">
  <% if (!pages.length) { %>
    <%- include('partials/empty', { emptyText: 'No pages found.' }) %>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Page</th><th>Web address</th><th>Last updated</th><th class="actions-col"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
          <% pages.forEach((p) => { %>
            <tr>
              <td>
                <div class="row-media">
                  <span class="thumb thumb-empty"><svg class="icon"><use href="#i-file"/></svg></span>
                  <span>
                    <a class="row-title" href="/admin/pages/<%= encodeURIComponent(p.slug) %>/edit"><%= p.title %></a>
                    <span class="sub"><%= p.words.toLocaleString('en-IN') %> word<%= p.words === 1 ? '' : 's' %></span>
                  </span>
                </div>
              </td>
              <td><a class="mono link-quiet" href="<%= pageUrlFor(p.slug) %>" target="_blank" rel="noopener"><%= pageUrlFor(p.slug) %></a></td>
              <td class="nowrap"><%= h.formatDate(p.updated_at, true) %></td>
              <td class="actions-col">
                <div class="row-actions">
                  <a class="btn btn-ghost btn-sm btn-icon" href="/admin/pages/<%= encodeURIComponent(p.slug) %>/edit" title="Edit" aria-label="Edit <%= p.title %>"><svg class="icon"><use href="#i-edit"/></svg></a>
                  <a class="btn btn-ghost btn-sm btn-icon" href="<%= pageUrlFor(p.slug) %>" target="_blank" rel="noopener" title="View on store" aria-label="View <%= p.title %> on the store"><svg class="icon"><use href="#i-eye"/></svg></a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('partials/bottom') %>
