<%- include('../partials/header') %>
<section class="error-page">
  <div class="container container-narrow center">
    <img class="error-emblem" src="/images/emblem-md.png" alt="" width="320" height="210">
    <p class="error-code"><%= typeof code !== 'undefined' ? code : 'Oops' %></p>
    <h1><%= title %></h1>
    <p class="lead muted"><%= message %></p>
    <div class="btn-row center-row">
      <a class="btn btn-gold" href="/shop">Browse the collection</a>
      <a class="btn btn-outline" href="/">Back to home</a>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
